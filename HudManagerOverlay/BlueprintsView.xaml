<UserControl x:Class="HudManagerOverlay.BlueprintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="620" Height="480">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Margin="8,8,8,8" Padding="6"
                     Background="#1A2530" Foreground="White" BorderBrush="{StaticResource Cyan}" BorderThickness="1"
                     FontFamily="Consolas" TextChanged="SearchBox_TextChanged"/>

            <ListBox x:Name="BlueprintList" Grid.Row="1" Margin="4,0,4,8" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="BlueprintList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverRow}" Padding="8,6" Margin="2,1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="Consolas" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}">
                                    <Run Text="{Binding CraftTimeText}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SourceCountText}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <Border Grid.Column="1" Background="#1A2530" BorderBrush="{StaticResource Cyan}" BorderThickness="1,0,0,0" Padding="12,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="NoSelectionText" Text="Select a blueprint to see details"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>

                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <TextBlock x:Name="NameText" Style="{StaticResource StatValue}" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DefaultBadge" Text="Available by default" Foreground="{StaticResource Cyan}"
                                   FontFamily="Consolas" FontSize="10" Margin="0,2,0,10"/>

                        <TextBlock Text="CRAFT TIME" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="CraftTimeDetailText" Style="{StaticResource StatValue}" Margin="0,0,0,8"/>

                        <TextBlock Text="INGREDIENTS" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="IngredientText" Style="{StaticResource StatValue}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="SourcesHeader" Text="UNLOCK SOURCES" Style="{StaticResource StatLabel}" Margin="0,4,0,4"/>
                        <ItemsControl x:Name="SourceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22000000" CornerRadius="4" Padding="6,4" Margin="0,0,0,3">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontFamily="Consolas" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ScopeAndChance}" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
