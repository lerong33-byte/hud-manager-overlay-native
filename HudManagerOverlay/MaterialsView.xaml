<UserControl x:Class="HudManagerOverlay.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420" Height="480">
    <Grid Background="#1A2530">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="8,8,8,4" Padding="6"
                 Background="#1A2530" Foreground="White" BorderBrush="{StaticResource Cyan}" BorderThickness="1"
                 FontFamily="Consolas" TextChanged="SearchBox_TextChanged"/>

        <Grid Grid.Row="1" Margin="10,2,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="NAME" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
            <TextBlock Grid.Column="1" Text="TIER" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
            <TextBlock Grid.Column="2" Text="RS" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Amber}"/>
            <TextBlock Grid.Column="3" Text="MINE" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
        </Grid>

        <ListBox x:Name="MaterialList" Grid.Row="2" Margin="4,0,4,8" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HoverRow}" Padding="6,4" Margin="2,1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding Tier}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="2" Text="{Binding RsText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                            <TextBlock Grid.Column="3" Text="{Binding MineableText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
