<UserControl x:Class="HudManagerOverlay.MissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="680" Height="480">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Category list -->
        <ListBox x:Name="CategoryList" Grid.Column="0" Margin="8,8,4,8" Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="{StaticResource Cyan}"
                 SelectionChanged="CategoryList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HoverRow}" Padding="6,5" Margin="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontFamily="Consolas" FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Count}" Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="9"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Mission list within category -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox" Grid.Row="0" Margin="4,8,8,8" Padding="6"
                     Background="#1A2530" Foreground="White" BorderBrush="{StaticResource Cyan}" BorderThickness="1"
                     FontFamily="Consolas" TextChanged="SearchBox_TextChanged"/>

            <ListBox x:Name="MissionList" Grid.Row="1" Margin="4,0,4,8" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="MissionList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverRow}" Padding="8,6" Margin="2,1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="Consolas" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextDim}">
                                    <Run Text="{Binding RewardText}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SystemsText}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- Detail pane -->
        <Border Grid.Column="2" Background="#1A2530" BorderBrush="{StaticResource Cyan}" BorderThickness="1,0,0,0" Padding="12,8">
            <StackPanel>
                <TextBlock x:Name="NoSelectionText" Text="Select a mission to see details"
                           Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>

                <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <TextBlock x:Name="TitleText" Style="{StaticResource StatValue}" FontSize="15" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GiverText" Style="{StaticResource StatLabel}" Margin="0,2,0,10"/>

                    <TextBlock Text="REWARD" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="RewardDetailText" Style="{StaticResource StatValue}" Margin="0,0,0,8"/>

                    <TextBlock Text="TIME ESTIMATE" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="TimeText" Style="{StaticResource StatValue}" Margin="0,0,0,8"/>

                    <TextBlock Text="ENEMIES" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="EnemyText" Style="{StaticResource StatValue}" Margin="0,0,0,8"/>

                    <TextBlock Text="SYSTEMS" Style="{StaticResource StatLabel}"/>
                    <TextBlock x:Name="SystemsDetailText" Style="{StaticResource StatValue}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TextBlock x:Name="IllegalBadge" Text="⚠ ILLEGAL ACTIVITY" Foreground="{StaticResource Magenta}"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
