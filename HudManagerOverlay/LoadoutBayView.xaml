<UserControl x:Class="HudManagerOverlay.LoadoutBayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Height="480">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="8,8,8,8" Padding="6"
                 Background="#1A2530" Foreground="White" BorderBrush="{StaticResource Cyan}" BorderThickness="1"
                 FontFamily="Consolas" TextChanged="SearchBox_TextChanged"/>

        <ListBox x:Name="ShipList" Grid.Row="1" Margin="4,0,4,8" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HoverRow}" Padding="8,6" Margin="2,1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="Consolas" FontSize="13" FontWeight="Bold"/>
                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}">
                                <Run Text="{Binding Manufacturer}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Role}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Size}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
