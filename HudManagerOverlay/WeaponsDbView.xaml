<UserControl x:Class="HudManagerOverlay.WeaponsDbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520" Height="480">
    <Grid Background="#1A2530">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="8,8,8,4" Padding="6"
                 Background="#1A2530" Foreground="White" BorderBrush="{StaticResource Cyan}" BorderThickness="1"
                 FontFamily="Consolas" TextChanged="SearchBox_TextChanged"/>
        <TextBlock Grid.Row="1" Text="Approximate base stats — full power, no gimbal/distance falloff modeled"
                   FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}" Margin="10,0,8,4" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Margin="10,2,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="NAME" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
            <TextBlock Grid.Column="1" Text="SZ" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
            <TextBlock Grid.Column="2" Text="DMG" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
            <TextBlock Grid.Column="3" Text="RPM" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource TextDim}"/>
            <TextBlock Grid.Column="4" Text="DPS" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Amber}"/>
        </Grid>

        <ListBox x:Name="WeaponList" Grid.Row="3" Margin="4,0,4,8" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource HoverRow}" Padding="6,4" Margin="2,1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="1" Text="{Binding Size}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DamageText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="3" Text="{Binding FireRateText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Grid.Column="4" Text="{Binding DpsText}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
