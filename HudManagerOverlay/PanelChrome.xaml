<UserControl x:Class="HudManagerOverlay.PanelChrome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Cyan}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                  MouseMove="TitleBar_MouseMove">
                <TextBlock x:Name="TitleText" Foreground="{StaticResource Cyan}" FontFamily="Consolas" FontSize="13"
                           VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="Bold"/>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="24" Margin="0,0,6,0" Background="Transparent" Foreground="{StaticResource TextDim}"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <ContentPresenter x:Name="Content1" Grid.Row="1"/>

            <!-- Resize grip: bottom-right corner drag -->
            <Thumb x:Name="ResizeThumb" Width="14" Height="14" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Cursor="SizeNWSE" Background="Transparent" DragDelta="ResizeThumb_DragDelta"/>
        </Grid>
    </Border>
</UserControl>
