<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared brand palette (cyan / amber / magenta only, no red/green) so every panel matches
         without redefining these in each file. -->
    <SolidColorBrush x:Key="PanelBg" Color="#E6101018"/>
    <SolidColorBrush x:Key="Cyan" Color="#5FE0FF"/>
    <SolidColorBrush x:Key="Amber" Color="#FFB840"/>
    <SolidColorBrush x:Key="Magenta" Color="#FF5FD1"/>
    <SolidColorBrush x:Key="TextDim" Color="#9FB4C0"/>

    <Style x:Key="HoverRow" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#22FFB840"/>
                <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
